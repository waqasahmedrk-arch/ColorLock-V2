<mxfile host="drawio"><diagram id="methodology" name="Methodology"><mxGraphModel dx="1700" dy="1200" grid="0" gridSize="10" guides="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1170" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;ColourLock: Methodology&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#555555&quot;&gt;Measuring how accurately and consistently FLUX.1-schnell and SDXL reproduce a specified colour&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1620" height="50" as="geometry"/></mxCell><mxCell id="lane1" value="&lt;b&gt;① Study design and data generation&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3F7FD;strokeColor=#6C8EBF;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="1620" height="230" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b&gt;1. Colour targets&lt;/b&gt;&lt;br&gt;8 CSS3/X11 hex colours spanning the hue wheel&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;royal blue · firebrick · forest green · goldenrod · dark orchid · sienna · teal · crimson&lt;/span&gt;&lt;br&gt;hex → sRGB → CIELAB (D65, 2°)&lt;br&gt;&lt;i&gt;Digital reference, not Pantone&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="330" height="160" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b&gt;2. Prompt construction&lt;/b&gt;&lt;br&gt;5 prompt styles:&lt;br&gt;A hex-only · B named + hex&lt;br&gt;C reference-anchor · D explicit CIELAB&lt;br&gt;E name-only&lt;br&gt;Checked against the 77-token CLIP budget&lt;br&gt;(no silent truncation)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="450" y="130" width="340" height="160" as="geometry"/></mxCell><mxCell id="flux" value="&lt;b&gt;FLUX.1-schnell&lt;/b&gt; · 4 steps · guidance 0&lt;br&gt;fp8_layerwise · no negative prompt" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="850" y="130" width="370" height="75" as="geometry"/></mxCell><mxCell id="sdxl" value="&lt;b&gt;SDXL base 1.0&lt;/b&gt; · 30 steps · CFG 7.0&lt;br&gt;fp16 · study negative prompt" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="850" y="215" width="370" height="75" as="geometry"/></mxCell><mxCell id="gen" value="&lt;b&gt;3. Image generation&lt;/b&gt;&lt;br&gt;Off-the-shelf models via diffusers,&lt;br&gt;pinned Hugging Face revisions&lt;br&gt;512 × 512 px · seed = slot + attempt × 1000&lt;br&gt;2 models × 8 colours × 5 styles × 32&lt;br&gt;= &lt;b&gt;2,560 images&lt;/b&gt; · generated once (MAX_RETRIES = 0)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="1270" y="130" width="360" height="160" as="geometry"/></mxCell><mxCell id="lane2" value="&lt;b&gt;② Measurement: colourlock package (parity-tested against notebook v15)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F4FAF2;strokeColor=#82B366;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontColor=#82B366;" vertex="1" parent="1"><mxGeometry x="40" y="350" width="1620" height="230" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b&gt;4. Colour extraction&lt;/b&gt;&lt;br&gt;Central 50% crop → CIELAB&lt;br&gt;KMeans (k = 4) on ≤ 20,000 pixels&lt;br&gt;Centroid of the largest cluster = &lt;b&gt;sample_lab&lt;/b&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="1130" y="390" width="500" height="160" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b&gt;5. Flatness QC gate&lt;/b&gt;&lt;br&gt;flat_p95_de = p95 ΔE00 of crop pixels from the crop&#x27;s median colour&lt;br&gt;Pass if flat_p95_de ≤ FLAT_P95_DE_MAX (3.0, read from config)&lt;br&gt;Pass rate: FLUX 763 / 1,280 (59.6%) · SDXL 9 / 1,280 (0.7%)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="390" width="480" height="160" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b&gt;6. Per-image metrics&lt;/b&gt;&lt;br&gt;Accuracy: ΔE00 (CIEDE2000), sample → target&lt;br&gt;Chroma drift: C*&lt;sub&gt;sample&lt;/sub&gt; − C*&lt;sub&gt;reference&lt;/sub&gt;&lt;br&gt;(negative = desaturation)&lt;br&gt;kept_pct logged for ablation only&lt;br&gt;&lt;i&gt;Computed for every image; analysis uses QC-passed only&lt;/i&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="390" width="480" height="160" as="geometry"/></mxCell><mxCell id="lane3" value="&lt;b&gt;③ Statistical analysis: frozen study dataset only&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#FFF8EF;strokeColor=#D79B00;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontColor=#D79B00;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="1620" height="230" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b&gt;7. Group metrics&lt;/b&gt;&lt;br&gt;Group = model × colour × style (n = 32 before QC)&lt;br&gt;Accuracy = mean ΔE00 to target&lt;br&gt;Consistency = mean ΔE00 to the group centroid&lt;br&gt;(mean Lab of QC-passed samples)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="650" width="480" height="160" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;8. Hypothesis tests&lt;/b&gt;&lt;br&gt;&lt;b&gt;H1&lt;/b&gt; Accuracy and consistency decouple: Spearman ρ across groups&lt;br&gt;&lt;b&gt;H2&lt;/b&gt; Drift is biased toward desaturation: one-sided Wilcoxon signed-rank on chroma drift&lt;br&gt;&lt;b&gt;H3&lt;/b&gt; One prompt style is most consistent: Levene + Kruskal–Wallis" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="600" y="650" width="480" height="160" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;9. Reliability checks and disclosures&lt;/b&gt;&lt;br&gt;Guard: ≥ 100 QC-passed images and ≥ 5 groups with n ≥ 10&lt;br&gt;Per-model group counts reported (SDXL: 0 groups with n ≥ 10)&lt;br&gt;Disclosed: fp8 vs fp16, negative-prompt asymmetry,&lt;br&gt;512 px vs 1024 px training, CSS3 reference" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="1130" y="650" width="500" height="160" as="geometry"/></mxCell><mxCell id="lane4" value="&lt;b&gt;④ Live web application (Next.js frontend + FastAPI)&lt;/b&gt;" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F8F4FA;strokeColor=#9673A6;strokeWidth=1.5;dashed=1;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=15;fontColor=#9673A6;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="1620" height="270" as="geometry"/></mxCell><mxCell id="d3" value="&lt;b&gt;Generate + score&lt;/b&gt;&lt;br&gt;FLUX or SDXL on a GPU worker&lt;br&gt;(one model per process, pinned revision)&lt;br&gt;Redis job queue → PNG → scored on the saved bytes&lt;br&gt;with the same scoring path" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="70" y="910" width="370" height="160" as="geometry"/></mxCell><mxCell id="d2" value="&lt;b&gt;Score an image&lt;/b&gt;&lt;br&gt;Upload an image + target hex&lt;br&gt;→ ΔE00, flatness QC, chroma drift&lt;br&gt;Same colourlock code as the study · CPU only" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="490" y="910" width="370" height="160" as="geometry"/></mxCell><mxCell id="d1" value="&lt;b&gt;Study explorer&lt;/b&gt;&lt;br&gt;Browse published results, images and provenance&lt;br&gt;Read-only · no GPU" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="910" y="910" width="310" height="160" as="geometry"/></mxCell><mxCell id="d0" value="&lt;b&gt;Frozen study dataset&lt;/b&gt;&lt;br&gt;PostgreSQL (study_* tables)&lt;br&gt;+ object storage (2,560 PNGs)&lt;br&gt;H1–H3 never recomputed per request" style="shape=cylinder3;boundedLbl=1;size=12;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;strokeWidth=1.5;fontSize=12;fontColor=#1A1A1A;spacing=8;" vertex="1" parent="1"><mxGeometry x="1270" y="900" width="360" height="175" as="geometry"/></mxCell><mxCell id="prov" value="Provenance stored with every result: model_id · revision · precision · seed · package version · FLAT_P95_DE_MAX" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9673A6;dashed=1;fontSize=12;fontColor=#4D4D4D;fontStyle=2;" vertex="1" parent="1"><mxGeometry x="70" y="1088" width="1560" height="36" as="geometry"/></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a2" target="flux"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a2" target="sdxl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="flux" target="gen"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="sdxl" target="gen"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="2,560 PNGs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.64;entryY=0;" edge="1" parent="1" source="gen" target="b1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.85;exitY=1;entryX=0.85;entryY=0;" edge="1" parent="1" source="b3" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e12" value="published" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0.63;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c3" target="d0"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="d0" target="d1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4D4D4D;fontSize=11;fontColor=#333333;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="d3" target="d2"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>