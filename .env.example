# Names only. Put real values in .env (gitignored) or the platform secret store.
# Every variable is optional for local dev without Docker (SQLite + local files).

DATABASE_URL=
STORAGE_BACKEND=
LOCAL_STORAGE_ROOT=
S3_BUCKET=
S3_ENDPOINT_URL=
S3_PUBLIC_ENDPOINT_URL=
S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
URL_SIGNING_SECRET=
PUBLIC_BASE_URL=
FRONTEND_ORIGINS=
# Where links in sign-in alert emails point (defaults: http://localhost:3000 and :3001).
SITE_URL=
ADMIN_URL=
GIT_COMMIT=
PROMPT_TOKENIZER=
COLOURLOCK_CONFIG_DIR=

# Accounts (MySQL, e.g. mysql+pymysql://root:@127.0.0.1:3306/colourlock_auth)
AUTH_DATABASE_URL=
AUTH_SECRET=
SESSION_COOKIE_SECURE=
# smtp | console. Gmail: SMTP_USER = the address, SMTP_PASSWORD = a 16-char App Password.
EMAIL_BACKEND=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Worker only (Phase 3). Never set in the API.
HF_TOKEN=

# Emails that get admin panel access when they sign in (comma-separated).
ADMIN_EMAILS=
